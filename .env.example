# ==============================================================================
# InboxOps - Environment Configuration Template
# ==============================================================================

# Application & Environment
NODE_ENV=development
APP_PORT=3000
API_BASE_URL=http://localhost:3000/api/v1
WORKSPACE_TIMEZONE=Asia/Kolkata

# Authentication & Session
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=32-character-random-hex-encryption-key-here

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://inboxops_user:inboxops_password@localhost:5432/inboxops?schema=public

# Redis & BullMQ Queue
REDIS_URL=redis://localhost:6379

# Email Provider Configuration (Set to 'mock' for local development)
EMAIL_PROVIDER_MODE=mock # 'mock' | 'google' | 'microsoft'
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/integrations/microsoft/callback

# AI Extraction Provider
AI_PROVIDER=anthropic # 'anthropic' | 'openai' | 'mock'
AI_API_KEY=
AI_MODEL_NAME=claude-3-5-sonnet-latest

# Storage (Local or S3/MinIO for attachments)
STORAGE_DRIVER=local # 'local' | 's3'
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
